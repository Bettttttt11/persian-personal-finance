{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "persian-personal-finance",
  "main": "src/index.js",
  "compatibility_date": "2026-08-09",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/telegram", "/api/*", "/app"]
  },
  "kv_namespaces": [
    {
      "binding": "RECEIPTS_KV",
      "id": "d4862a9889e146bb835f9075a47baae1"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "WRITE_GATE", "class_name": "WriteGate" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WriteGate"] }
  ],
  "triggers": {
    "crons": ["30 3 * * *"]
  }
}
